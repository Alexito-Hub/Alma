<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: the partner's current "siente". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/status_author"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_badge"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#141210"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="TU PAREJA SIENTE" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:textColor="#141210"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end"
        android:text="…" />

    <TextView
        android:id="@+id/status_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#6B625A"
        android:textSize="10sp"
        android:maxLines="1"
        android:text="" />
</LinearLayout>
