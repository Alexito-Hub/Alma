# MongoDB Atlas — paste your SRV URL here (URL-encode special chars in the password).
# Example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/alma?retryWrites=true&w=majority
ALMA_MONGO_URL=mongodb://localhost:27017/alma
ALMA_MONGO_POOL=5

# Long random strings. Generate each with: mix phx.gen.secret
# In prod BOTH are required — the server refuses to boot without them, because
# the fallbacks in config/ are literals in a public repo.
ALMA_JWT_SECRET=replace-me-with-a-64-char-random-string
ALMA_SECRET_KEY_BASE=replace-me-with-a-64-char-random-string

# Where media files live on disk. Relative to server/ in dev.
ALMA_MEDIA_ROOT=priv/static/media

# Who may create an account, comma-separated. Alma serves two people behind a
# public tunnel; leave it empty and anyone reaching the host can register.
# Unset = open, so local dev and a first-time setup still work.
ALMA_ALLOWED_EMAILS=

# Serve /media without a session. Defaults to false: photos, clips and voice
# notes need the same Bearer token as the rest of the API.
# Set to true only while an app build older than that change is still on a
# phone — otherwise its media comes back 401.
ALMA_MEDIA_PUBLIC=false

# Extra browser origins allowed by CORS, comma-separated. The tunnel host is
# always allowed. The Flutter app sends no Origin header, so this is only
# about browsers.
ALMA_CORS_ORIGINS=

# Set to false to disable the WebSocket origin check, if a client ever turns
# out to send an Origin the allowlist doesn't cover.
ALMA_CHECK_ORIGIN=

# Production-only
ALMA_HOST=your.tunnel.example
PORT=4000
