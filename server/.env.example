# MongoDB Atlas — paste your SRV URL here (URL-encode special chars in the password).
# Example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/alma?retryWrites=true&w=majority
ALMA_MONGO_URL=mongodb://localhost:27017/alma
ALMA_MONGO_POOL=5

# Long random string. Generate with: mix phx.gen.secret
ALMA_JWT_SECRET=replace-me-with-a-64-char-random-string
ALMA_SECRET_KEY_BASE=replace-me-with-a-64-char-random-string

# Where media files live on disk. Relative to server/ in dev.
ALMA_MEDIA_ROOT=priv/static/media

# Production-only
ALMA_HOST=your.tunnel.example
PORT=4000
