<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: Alma server health at a glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <TextView
        android:id="@+id/server_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_badge"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="#141210"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="SERVIDOR" />

    <TextView
        android:id="@+id/server_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#141210"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="—" />

    <TextView
        android:id="@+id/server_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:textColor="#141210"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="" />

    <TextView
        android:id="@+id/server_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#6B625A"
        android:textSize="10sp"
        android:maxLines="1"
        android:text="" />
</LinearLayout>
